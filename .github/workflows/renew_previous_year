name: Renew Previous Year (연 1회 전체 재수집)

on:
  workflow_dispatch:
    inputs:
      reset_before_run:
        description: '전체를 처음부터 다시 수집할까요? (매년 4월, 새 연간 사이클 시작할 때만 체크)'
        required: true
        type: boolean
        default: false

jobs:
  renew-previous-year:
    runs-on: ubuntu-latest
    # ⚠️ GitHub Actions 호스팅 러너의 단일 job 최대 실행시간은 6시간(360분)임.
    # DART 일일 호출 한도(4만 건) 때문에 전체 재수집이 하루 안에 못 끝날 수도 있는데,
    # 그 경우 이 job 자체도 6시간 안에 다 못 끝날 수 있음 - 괜찮음, b_group_synced_at
    # 기준으로 resume되니까 그냥 다음날 이 워크플로우를 (reset 체크 없이) 다시
    # 수동으로 트리거하면 이어서 진행됨.
    timeout-minutes: 350

    steps:
      - name: 소스코드 체크아웃
        uses: actions/checkout@v4

      - name: Python 환경 설정
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: 필수 라이브러리 설치
        run: |
          pip install -r requirements.txt

      - name: 전체 재수집 실행
        env:
          DART_API_KEY: ${{ secrets.DART_API_KEY }}
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY }}
          RESET_BEFORE_RUN: ${{ inputs.reset_before_run }}
        run: |
          python renew_previous_year.py
